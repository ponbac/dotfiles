#!/usr/bin/env python3
# Preserve host authentication/settings; add only our shared include if missing.
from pathlib import Path
import os
import subprocess
import sys
import tempfile

text = sys.stdin.read()
include = str(Path.home() / '.config/git/shared.conf')
with tempfile.TemporaryDirectory(prefix='chezmoi-git-') as tmp:
    config = Path(tmp) / 'config'
    config.write_text(text)
    result = subprocess.run(['git', 'config', '--file', str(config), '--get-all', 'include.path'], text=True, capture_output=True)
    if result.returncode not in (0, 1):
        raise SystemExit('Cannot parse existing Git configuration; refusing to rewrite it')
    if include not in [os.path.expanduser(p) for p in result.stdout.splitlines()]:
        subprocess.run(['git', 'config', '--file', str(config), '--add', 'include.path', include], check=True)
    sys.stdout.write(config.read_text())
