#!/usr/bin/env python3
# Preserve the package's launcher fields; override only the icon path.
from pathlib import Path
import sys

sys.stdin.read()
launcher = Path('/usr/share/applications/t3code-nightly.desktop')
if not launcher.is_file():
    raise SystemExit('Install t3code-nightly-bin before applying the T3 Code launcher')
lines = launcher.read_text().splitlines(keepends=True)
icon = Path.home() / '.local/share/icons/t3code-nightly-custom.png'
if sum(line.startswith('Icon=') for line in lines) != 1:
    raise SystemExit('Expected exactly one Icon field in the packaged T3 Code launcher')
sys.stdout.write(''.join(f'Icon={icon}\n' if line.startswith('Icon=') else line for line in lines))
