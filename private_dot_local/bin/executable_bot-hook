#!/bin/bash
# Usage: bot-hook <kite|gon|nudge> <message...>   |   bot-hook --setup <bot>
# Sends a message to a Grok Bot agent's webhook routine. URL and key live in
# ~/.config/bot-hooks/<bot>.env (URL=..., KEY=...), never in the repo.
if [ "$1" = "--setup" ]; then
  b="$2"; f="$HOME/.config/bot-hooks/${b}.env"
  mkdir -p "$HOME/.config/bot-hooks"; chmod 700 "$HOME/.config/bot-hooks"
  read -rp "$b webhook URL: " u
  read -rsp "$b sender key (hidden): " k; echo
  umask 077; printf 'URL=%s\nKEY=%s\n' "$u" "$k" > "$f"
  echo "Saved $f"; exit 0
fi
bot="$1"; shift
msg="$*"
cfg="$HOME/.config/bot-hooks/${bot}.env"
if [ -z "$msg" ]; then notify-send "$bot" "Empty message, nothing sent"; exit 1; fi
if [ ! -r "$cfg" ]; then notify-send -u critical "$bot hook" "Missing $cfg"; echo "Missing $cfg"; exit 1; fi
# shellcheck disable=SC1090
. "$cfg"
if [ -z "$URL" ] || [ -z "$KEY" ]; then notify-send -u critical "$bot hook" "URL or KEY empty in $cfg"; exit 1; fi
host="$(hostname)"
case "$bot" in
  gon) body="$(jq -nc --arg f vicinae --arg m "$host" --arg t "vicinae" --arg msg "$msg" '{from:$f,machine:$m,thread:$t,message:$msg,needsReply:true}')" ;;
  *)   body="$(jq -nc --arg f vicinae --arg m "$host" --arg msg "$msg" '{from:$f,machine:$m,message:$msg}')" ;;
esac
code="$(curl -sS -m 8 -o /dev/null -w '%{http_code}' -X POST "$URL" \
  -H 'Content-Type: application/json' \
  -H "Authorization: Bearer $KEY" -H "X-Automation-Key: $KEY" \
  --data "$body" 2>/dev/null)"
if [ "$code" = "200" ]; then
  notify-send "Sent to $bot" "$msg"; echo "Sent to $bot"
else
  notify-send -u critical "$bot hook failed" "HTTP ${code:-none}"; echo "Failed: HTTP ${code:-none}"; exit 1
fi
