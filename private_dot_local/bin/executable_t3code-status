#!/usr/bin/python3
"""Report T3 Code thread status for the ponbac.t3code Omarchy bar widget.

Reads this machine's T3 Code server state read-only and reports three groups,
each a list of `{title, since, project, badge, badgeColor, provider, model,
state}`:

  needsYou  threads blocked on a pending approval or question, then snoozed
            threads that woke up since they were last opened (state "woke")
  working   threads with a run in progress, then threads whose run ended but
            that still wait on background work, such as a watched pull
            request or a delegated thread (state "waiting")
  done      threads whose latest run completed after they were last opened

The groups and states mirror the status labels in the T3 Code sidebar, which
counts Waiting threads in its Working shelf. Only top-level threads are
listed, by their own status; a subagent's pending request counts for its root
thread. A thread appears in one group only, and settled or snoozed threads
are left out of `done` the way the sidebar hides them.

Modes:
  (none)    print this machine's record once
  --serve   serve this machine's record over HTTP on its Tailscale address,
            so other machines' bars can include it without ssh
  --watch   print a merged record (this machine plus every --peer feed, each
            item tagged with `host`) whenever it changes; the widget runs this

The tables are T3 Code internals, not a public contract. A read failure
reports `error` and an unreachable peer is left out, so the widget shows
fewer threads rather than stale ones. Standard library only: the same file
runs on the Omarchy desktops and on the Ubuntu dev server.
"""

from __future__ import annotations

import argparse
import json
import os
import sqlite3
import subprocess
import sys
import socket
import threading
import time
import unicodedata
import urllib.request
from datetime import datetime, timezone
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from typing import Any

ACTIVE_RUN_STATUSES = ("preparing", "queued", "starting", "running", "waiting")
# Pending requests the server answers itself; the user is never asked.
INTERNAL_REQUEST_KINDS = ("dynamic_tool_call", "auth_refresh")
GROUPS = ("needsYou", "working", "done")

FEED_PORT = 37731
WATCH_INTERVAL_SECONDS = 2.0
HEARTBEAT_SECONDS = 20.0
PEER_POLL_SECONDS = 4.0
PEER_TIMEOUT_SECONDS = 3.0
SERVE_CACHE_SECONDS = 1.0

ITEM_KEYS = ("title", "since", "project", "badge", "badgeColor", "provider", "model", "state")

# Background work that holds a finished run open, as T3 Code decides it
# (orchestrationV2PendingBackgroundWork.ts). Plain commands and monitors do not
# hold it unless the agent awaits them; a watched pull request is an awaited
# monitor.
HOLDING_TASK_KINDS = ("subagent", "background_task")
# Run statuses after which background work can hold a thread in Waiting.
SETTLED_RUN_STATUSES = ("cancelled", "completed", "failed", "interrupted", "waiting")
LIVE_ITEM_STATUSES = ("pending", "running", "waiting")
# Turn items that run in the background; a live command is never a holding kind.
HOLDING_ITEM_TYPES = ("dynamic_tool", "subagent")
# Item types that count as the run's own work when deciding whether a running
# thread is only blocked on a wait for another thread.
EXECUTION_ITEM_TYPES = (
  "command_execution", "dynamic_tool", "subagent", "file_change", "file_search", "web_search", "compaction",
)

# T3 Code's project icon colours, in its order (the generated colour is an
# index into this list), as the Tailwind 400 shades its dark theme uses.
PROJECT_COLORS = {
  "gray": "#9ca3af", "red": "#f87171", "orange": "#fb923c", "amber": "#fbbf24",
  "yellow": "#facc15", "lime": "#a3e635", "green": "#4ade80", "emerald": "#34d399",
  "teal": "#2dd4bf", "cyan": "#22d3ee", "sky": "#38bdf8", "blue": "#60a5fa",
  "indigo": "#818cf8", "violet": "#a78bfa", "purple": "#c084fc", "fuchsia": "#e879f9",
  "pink": "#f472b6", "rose": "#fb7185",
}

ROOT_THREAD = "coalesce(json_extract(t.payload_json, '$.lineage.rootThreadId'), t.thread_id)"
LIVE_THREAD = "t.archived_at is null and t.deleted_at is null"
# The sidebar lists top-level threads; a finished subagent reports to its parent.
TOP_LEVEL = "json_extract(t.payload_json, '$.lineage.parentThreadId') is null"

NEEDS_YOU_SQL = f"""
  select {ROOT_THREAD} as root, min(q.created_at)
  from orchestration_v2_projection_runtime_requests q
  join orchestration_v2_projection_threads t using (thread_id)
  where q.status = 'pending'
    and q.kind not in ({",".join("?" * len(INTERNAL_REQUEST_KINDS))})
    and {LIVE_THREAD}
  group by root
"""

# `since` follows the sidebar's working timer: the newest active run's
# workStartedAt, which wake runs inherit from the prompt they continue, so a
# long task does not restart its clock at every background notification. A
# queued run only stands in when the thread has no run actually going.
WORKING_SQL = f"""
  with act as (
    select r.thread_id, r.run_id, r.status,
           coalesce(json_extract(r.payload_json, '$.workStartedAt'),
                    json_extract(r.payload_json, '$.startedAt'),
                    r.requested_at) as started,
           row_number() over (
             partition by r.thread_id
             order by (r.status = 'queued'), r.ordinal desc, r.run_id desc
           ) as n
    from orchestration_v2_projection_runs r
    where r.status in ({",".join("?" * len(ACTIVE_RUN_STATUSES))})
  )
  select t.thread_id, a.started, a.run_id, a.status
  from act a
  join orchestration_v2_projection_threads t using (thread_id)
  where a.n = 1 and {TOP_LEVEL} and {LIVE_THREAD}
"""

# The execution items still going in each running run; a run whose only such
# items are waits on other threads shows as Waiting, not Working.
RUN_ITEMS_SQL = f"""
  select i.run_id, i.type, json_extract(i.payload_json, '$.toolName'),
         json_extract(i.payload_json, '$.input.mode'), json_extract(i.payload_json, '$.origin')
  from orchestration_v2_projection_turn_items i
  where i.run_id in (select value from json_each(?))
    and i.status in ('running', 'waiting')
    and i.type in ({",".join("?" * len(EXECUTION_ITEM_TYPES))})
"""

# Each top-level thread's latest run, for threads that could be holding
# background work: a provider thread with pending tasks, a live background
# item, or a pull request link with a watch.
LATEST_RUN_SQL = f"""
  with latest as (
    select thread_id, status, completed_at,
           row_number() over (partition by thread_id order by ordinal desc) as n
    from orchestration_v2_projection_runs
  )
  select t.thread_id, t.active_provider_thread_id, json_extract(t.payload_json, '$.pullRequests'),
         l.status, l.completed_at
  from orchestration_v2_projection_threads t
  left join latest l on l.thread_id = t.thread_id and l.n = 1
  where {TOP_LEVEL} and {LIVE_THREAD}
    and (
      t.thread_id in (
        select thread_id from orchestration_v2_projection_provider_threads
        where json_array_length(json_extract(payload_json, '$.pendingBackgroundTasks')) > 0
      )
      or t.thread_id in (
        select thread_id from orchestration_v2_projection_turn_items
        where status in ({",".join("?" * len(LIVE_ITEM_STATUSES))})
          and type in ({",".join("?" * len(HOLDING_ITEM_TYPES))})
      )
      or t.payload_json like '%"watch"%'
    )
"""

PROVIDER_TASKS_SQL = """
  select provider_thread_id, json_extract(payload_json, '$.pendingBackgroundTasks')
  from orchestration_v2_projection_provider_threads
  where thread_id = ? and json_array_length(json_extract(payload_json, '$.pendingBackgroundTasks')) > 0
"""

LIVE_ITEMS_SQL = f"""
  select i.type, json_extract(i.payload_json, '$.input.persistent'), r.status
  from orchestration_v2_projection_turn_items i
  left join orchestration_v2_projection_runs r on r.run_id = i.run_id
  where i.thread_id = ?
    and i.status in ({",".join("?" * len(LIVE_ITEM_STATUSES))})
    and i.type in ({",".join("?" * len(HOLDING_ITEM_TYPES))})
"""

# Snoozed threads whose snooze ran out after they were last opened: the
# sidebar's Woke label. A thread that wakes because it needs the user is
# already in needsYou.
WOKE_SQL = f"""
  select t.thread_id, json_extract(t.payload_json, '$.snoozedUntil') as woke
  from orchestration_v2_projection_threads t
  where woke is not null
    and woke <= ?
    and woke > coalesce(json_extract(t.payload_json, '$.lastVisitedAt'), '')
    and coalesce(json_extract(t.payload_json, '$.settledOverride'), '') != 'settled'
    and {TOP_LEVEL} and {LIVE_THREAD}
"""

# Top-level threads only: a finished subagent reports to its parent, not the user.
DONE_SQL = f"""
  with latest as (
    select thread_id, status, completed_at,
           row_number() over (partition by thread_id order by ordinal desc) as n
    from orchestration_v2_projection_runs
  )
  select t.thread_id, l.completed_at
  from latest l
  join orchestration_v2_projection_threads t using (thread_id)
  where l.n = 1
    and l.status = 'completed'
    and l.completed_at > json_extract(t.payload_json, '$.lastVisitedAt')
    and {TOP_LEVEL}
    and coalesce(json_extract(t.payload_json, '$.settledOverride'), '') != 'settled'
    and not (
      coalesce(json_extract(t.payload_json, '$.snoozedUntil'), '') > ?
      and l.completed_at <= coalesce(json_extract(t.payload_json, '$.snoozedAt'), '')
    )
    and {LIVE_THREAD}
"""


def base_dir() -> Path:
  return Path(os.environ.get("T3CODE_USERDATA") or (Path.home() / ".t3" / "userdata"))


def server_running(root: Path) -> bool:
  try:
    pid = int(json.loads((root / "server-runtime.json").read_text())["pid"])
    os.kill(pid, 0)
  except PermissionError:
    return True
  except (OSError, ValueError, KeyError, TypeError):
    return False
  return True


def now_iso() -> str:
  return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.") + "000Z"


def project_badge(name: str, icon_json: str | None) -> tuple[str, str]:
  """The two-letter badge and colour T3 Code generates for a project.

  Mirrors deriveProjectIdentity in T3 Code's projectIdentity.ts. A stored icon
  overrides the colour, and the text when it is a monogram or emoji; Lucide
  icons have no equivalent here, so those keep the generated letters.
  """
  name = unicodedata.normalize("NFKC", name or "").strip()
  words = "".join(ch if ch.isalnum() else " " for ch in name).split()
  if words:
    first_word = words[0]
    digit = next((ch for ch in first_word[1:] if ch.isdigit()), None)
    second = digit or (words[-1][0] if len(words) > 1 else first_word[-1])
    text = (first_word[0] + second).upper()[:2]
  else:
    text = "PR"
  index = 0
  for ch in name.lower() or "project":
    index = (index * 31 + ord(ch)) % len(PROJECT_COLORS)
  color = list(PROJECT_COLORS)[index]

  try:
    icon = json.loads(icon_json) if icon_json else None
  except ValueError:
    icon = None
  if isinstance(icon, dict):
    color = icon.get("color") if icon.get("color") in PROJECT_COLORS else color
    override = icon.get("text") or icon.get("emoji") or icon.get("value")
    if icon.get("kind") in ("monogram", "emoji") and isinstance(override, str) and override.strip():
      text = override.strip()
  return text, PROJECT_COLORS[color]


def is_thread_wait(tool_name: str | None, mode: str | None) -> bool:
  """A T3 tool call that only waits on another thread: t3_thread_wait, or delegate_task in wait mode."""
  tool = (tool_name or "").rsplit("__", 1)[-1]
  return tool == "t3_thread_wait" or (tool == "delegate_task" and mode == "wait")


def blocked_on_thread_wait(db: sqlite3.Connection, running_runs: list[str]) -> set[str]:
  """Running runs whose only live execution items are waits on other threads."""
  if not running_runs:
    return set()
  waits: set[str] = set()
  busy: set[str] = set()
  rows = db.execute(RUN_ITEMS_SQL, (json.dumps(running_runs), *EXECUTION_ITEM_TYPES))
  for run_id, item_type, tool_name, mode, origin in rows:
    if item_type == "subagent" and origin == "app_owned":
      continue
    if item_type == "dynamic_tool" and is_thread_wait(tool_name, mode):
      waits.add(run_id)
    else:
      busy.add(run_id)
  return waits - busy


def holds_background_work(db: sqlite3.Connection, thread_id: str, active_provider: str | None,
                          pull_requests: str | None, latest_status: str | None) -> bool:
  """Whether a thread whose run has ended still waits on background work."""
  for link in json_list(pull_requests):
    snapshot = link.get("snapshot") if isinstance(link.get("snapshot"), dict) else {}
    if link.get("watch") is not None and link.get("source") != "stack-dismissed" and snapshot.get("state") != "merged":
      return True
  if latest_status not in SETTLED_RUN_STATUSES or latest_status == "failed":
    return False
  for provider_thread, tasks in db.execute(PROVIDER_TASKS_SQL, (thread_id,)):
    if active_provider and provider_thread != active_provider:
      continue
    for task in json_list(tasks):
      if task.get("awaited") is True or task.get("kind") in HOLDING_TASK_KINDS:
        return True
  rows = db.execute(LIVE_ITEMS_SQL, (thread_id, *LIVE_ITEM_STATUSES, *HOLDING_ITEM_TYPES))
  return any(
    not (item_type == "dynamic_tool" and persistent in (1, True)) and run_status != "rolled_back"
    for item_type, persistent, run_status in rows
  )


def json_list(text: str | None) -> list[dict[str, Any]]:
  try:
    value = json.loads(text) if text else []
  except ValueError:
    return []
  return [item for item in value if isinstance(item, dict)] if isinstance(value, list) else []


def group(db: sqlite3.Connection, since_by_thread: dict[str, str], newest_first: bool,
          state_by_thread: dict[str, str] | None = None) -> list[dict[str, str]]:
  if not since_by_thread:
    return []
  state_by_thread = state_by_thread or {}
  marks = ",".join("?" * len(since_by_thread))
  rows = db.execute(
    f"""
    select t.thread_id, t.title, t.default_provider,
           json_extract(t.payload_json, '$.modelSelection.model'),
           p.title, p.project_icon_json
    from orchestration_v2_projection_threads t
    left join projection_projects p on p.project_id = t.project_id
    where t.thread_id in ({marks})
    """,
    list(since_by_thread),
  )
  items = []
  for thread_id, title, provider, model, project, icon_json in rows:
    badge, badge_color = project_badge(project, icon_json) if project else ("", "")
    items.append({
      "title": str(title or "Untitled thread"),
      "since": since_by_thread[thread_id],
      "project": str(project or ""),
      "badge": badge,
      "badgeColor": badge_color,
      "provider": str(provider or ""),
      "model": str(model or ""),
      "state": state_by_thread.get(thread_id, ""),
    })
  # A state ("woke", "waiting") sorts after the group's own threads.
  return sorted(
    sorted(items, key=lambda item: item["since"], reverse=newest_first),
    key=lambda item: item["state"] != "",
  )


def collect() -> dict[str, Any]:
  root = base_dir()
  if not server_running(root):
    return {"status": "offline"}
  try:
    db = sqlite3.connect(f"file:{root / 'statev2.sqlite'}?mode=ro", uri=True, timeout=1.0)
    try:
      now = now_iso()
      needs = dict(db.execute(NEEDS_YOU_SQL, INTERNAL_REQUEST_KINDS))
      active = [row for row in db.execute(WORKING_SQL, ACTIVE_RUN_STATUSES) if row[0] not in needs]
      blocked = blocked_on_thread_wait(db, [run for _, _, run, status in active if status == "running"])
      working = {thread: since for thread, since, run, _ in active if run not in blocked}
      waiting = {thread: since for thread, since, run, _ in active if run in blocked}
      for thread, provider, pull_requests, status, completed in db.execute(
        LATEST_RUN_SQL, (*LIVE_ITEM_STATUSES, *HOLDING_ITEM_TYPES)
      ):
        if thread in needs or thread in working or thread in waiting:
          continue
        if status in ("preparing", "starting", "running"):
          continue
        if holds_background_work(db, thread, provider, pull_requests, status):
          waiting[thread] = completed or now
      busy = needs.keys() | working.keys() | waiting.keys()
      woke = {k: v for k, v in db.execute(WOKE_SQL, (now,)) if k not in busy}
      done = {k: v for k, v in db.execute(DONE_SQL, (now,)) if k not in busy and k not in woke}
      states = {**{k: "waiting" for k in waiting}, **{k: "woke" for k in woke}}
      return {
        "status": "ok",
        "needsYou": group(db, {**needs, **woke}, newest_first=False, state_by_thread=states),
        "working": group(db, {**working, **waiting}, newest_first=False, state_by_thread=states),
        "done": group(db, done, newest_first=True),
      }
    finally:
      db.close()
  except sqlite3.Error:
    return {"status": "error"}


def tailscale_ip() -> str | None:
  try:
    out = subprocess.run(["tailscale", "ip", "-4"], capture_output=True, text=True, timeout=5)
  except (OSError, subprocess.SubprocessError):
    return None
  address = out.stdout.strip().splitlines()[0] if out.returncode == 0 and out.stdout.strip() else ""
  return address or None


def serve() -> None:
  # Bound to the Tailscale address only, never the LAN: thread titles are the
  # payload, and the tailnet is the access boundary.
  while (address := tailscale_ip()) is None:
    time.sleep(5)

  lock = threading.Lock()
  cached: dict[str, Any] = {"at": 0.0, "body": b""}

  class Handler(BaseHTTPRequestHandler):
    def do_GET(self) -> None:
      with lock:
        if time.monotonic() - cached["at"] >= SERVE_CACHE_SECONDS:
          cached["body"] = json.dumps(collect(), separators=(",", ":")).encode()
          cached["at"] = time.monotonic()
        body = cached["body"]
      self.send_response(200)
      self.send_header("Content-Type", "application/json")
      self.send_header("Content-Length", str(len(body)))
      self.end_headers()
      self.wfile.write(body)

    def log_message(self, *_: Any) -> None:
      pass

  ThreadingHTTPServer((address, FEED_PORT), Handler).serve_forever()


class Peer:
  """Polls one machine's feed in the background; `record` is None while unreachable."""

  def __init__(self, host: str) -> None:
    self.host = host
    self.record: dict[str, Any] | None = None
    threading.Thread(target=self._poll, daemon=True).start()

  def _poll(self) -> None:
    url = f"http://{self.host}:{FEED_PORT}/"
    while True:
      try:
        with urllib.request.urlopen(url, timeout=PEER_TIMEOUT_SECONDS) as response:
          record = json.loads(response.read())
        self.record = record if isinstance(record, dict) and record.get("status") == "ok" else None
      except (OSError, ValueError):
        self.record = None
      time.sleep(PEER_POLL_SECONDS)


def merged(peers: list[Peer]) -> dict[str, Any]:
  sources = [(socket.gethostname(), collect())] + [(peer.host, peer.record) for peer in peers]
  record: dict[str, Any] = {"status": "ok"}
  for name in GROUPS:
    record[name] = [
      {**{key: str(item.get(key) or "") for key in ITEM_KEYS}, "host": host}
      for host, source in sources
      if source and source.get("status") == "ok"
      for item in source.get(name, [])
      if isinstance(item, dict)
    ]
  return record


def watch(hosts: list[str]) -> None:
  peers = [Peer(host) for host in hosts]
  parent = os.getppid()
  last = None
  printed_at = 0.0
  while os.getppid() == parent:
    record = json.dumps(merged(peers), separators=(",", ":"))
    # Repeating an unchanged record is a heartbeat, so a closed reader
    # surfaces as a broken pipe instead of leaving this running.
    if record != last or time.monotonic() - printed_at >= HEARTBEAT_SECONDS:
      print(record, flush=True)
      last = record
      printed_at = time.monotonic()
    time.sleep(WATCH_INTERVAL_SECONDS)


def main() -> int:
  parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
  mode = parser.add_mutually_exclusive_group()
  mode.add_argument("--serve", action="store_true", help="serve this machine's record on its Tailscale address")
  mode.add_argument("--watch", action="store_true", help="print a merged record whenever it changes")
  parser.add_argument("--peer", action="append", default=[], metavar="HOST", help="machine whose feed --watch includes")
  args = parser.parse_args()
  try:
    if args.serve:
      serve()
    elif args.watch:
      watch(args.peer)
    else:
      print(json.dumps(collect()))
  except KeyboardInterrupt:
    pass
  except BrokenPipeError:
    # Keep the interpreter's exit-time flush from reporting the same pipe.
    os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
  return 0


if __name__ == "__main__":
  sys.exit(main())
